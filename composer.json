{
    "name": "zaeem2396/beacon",
    "description": "Laravel Beacon - safe, structured Laravel production intelligence for AI agents over MCP",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "mcp",
        "ai",
        "observability",
        "production",
        "diagnostics"
    ],
    "require": {
        "php": "^8.2",
        "illuminate/contracts": "^11.0|^12.0|^13.0",
        "illuminate/support": "^11.0|^12.0|^13.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.64",
        "larastan/larastan": "^3.0",
        "orchestra/testbench": "^9.0|^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Beacon\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Beacon\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Beacon\\BeaconServiceProvider"
            ]
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit",
        "analyse": "phpstan analyse --memory-limit=512M",
        "format": "php-cs-fixer fix",
        "format:test": "php-cs-fixer fix --dry-run --diff",
        "pre-check": [
            "@format:test",
            "@analyse",
            "@test"
        ]
    }
}
